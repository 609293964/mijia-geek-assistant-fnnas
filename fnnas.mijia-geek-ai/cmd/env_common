#!/bin/bash

CONFIG_FILE="${TRIM_PKGETC}/mijia-geek-ai.env"
DEFAULT_CONFIG="${TRIM_APPDEST}/config/mijia-geek-ai.env.example"

shell_quote() {
    local value="$1"
    value=${value//$'\r'/}
    value=${value//$'\n'/}
    value=${value//\'/\'\\\'\'}
    printf "'%s'" "${value}"
}

gateway_host_from_url() {
    local value="$1"
    value="${value#http://}"
    value="${value#https://}"
    value="${value%%/*}"
    value="${value%%:*}"
    printf "%s" "${value}"
}

gateway_type_from_url() {
    local value="$1"
    value="${value#http://}"
    value="${value#https://}"
    value="${value%%/*}"

    case "${value}" in
        *:8086)
            printf "router"
            ;;
        *)
            printf "physical"
            ;;
    esac
}

normalize_gateway_type() {
    case "$1" in
        router)
            printf "router"
            ;;
        *)
            printf "physical"
            ;;
    esac
}

gateway_url_from_host_and_type() {
    local host="$1"
    local type="$2"

    host="${host#http://}"
    host="${host#https://}"
    host="${host%%/*}"
    host="${host%%:*}"

    case "${type}" in
        router)
            printf "http://%s:8086" "${host}"
            ;;
        physical|*)
            printf "http://%s" "${host}"
            ;;
    esac
}

prepare_config_dir() {
    mkdir -p "${TRIM_PKGETC}"

    if [ ! -f "${CONFIG_FILE}" ] && [ -f "${DEFAULT_CONFIG}" ]; then
        cp "${DEFAULT_CONFIG}" "${CONFIG_FILE}"
    fi
}

load_existing_config() {
    if [ -f "${CONFIG_FILE}" ]; then
        set -a
        . "${CONFIG_FILE}"
        set +a
    fi
}

write_mijia_geek_ai_env() {
    prepare_config_dir
    load_existing_config

    local llm_base_url="${wizard_llm_base_url:-${LLM_BASE_URL:-https://api.openai.com/v1}}"
    local llm_api_key="${wizard_llm_api_key:-${LLM_API_KEY:-}}"
    local llm_model="${wizard_llm_model:-${LLM_MODEL:-gpt-4o}}"
    local llm_temperature="${wizard_llm_temperature:-${LLM_TEMPERATURE:-0.7}}"
    local existing_gateway_host="${GATEWAY_HOST:-$(gateway_host_from_url "${GATEWAY_URL:-http://192.0.2.1}")}"
    local existing_gateway_type="${GATEWAY_TYPE:-$(gateway_type_from_url "${GATEWAY_URL:-http://192.0.2.1}")}"
    local gateway_host="${wizard_gateway_host:-${existing_gateway_host:-192.0.2.1}}"
    local gateway_type="$(normalize_gateway_type "${wizard_gateway_type:-${existing_gateway_type:-physical}}")"
    local gateway_url="$(gateway_url_from_host_and_type "${gateway_host}" "${gateway_type}")"
    local app_port="${wizard_app_port:-${APP_PORT:-3010}}"
    local tmp_file="${CONFIG_FILE}.tmp"

    cat > "${tmp_file}" <<EOF
# Generated by fnOS wizard. Edit from app settings when possible.
LLM_BASE_URL=$(shell_quote "${llm_base_url}")
LLM_API_KEY=$(shell_quote "${llm_api_key}")
LLM_MODEL=$(shell_quote "${llm_model}")
LLM_TEMPERATURE=$(shell_quote "${llm_temperature}")
APP_PORT=$(shell_quote "${app_port}")
GATEWAY_HOST=$(shell_quote "${gateway_host}")
GATEWAY_TYPE=$(shell_quote "${gateway_type}")
GATEWAY_URL=$(shell_quote "${gateway_url}")
EOF

    chmod 600 "${tmp_file}" 2>/dev/null || true
    mv "${tmp_file}" "${CONFIG_FILE}"
}
